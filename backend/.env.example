# MongoDB connection string (required for every content API).
MONGODB_URI=

# Secret used to sign admin JWTs. Use a long random string; rotating it signs everyone out.
JWT_SECRET=
JWT_EXPIRES_IN=8h

# Comma-separated list of browser origins allowed to call this API.
# Leave empty only for local development; production must set it.
# Example: https://fuera.vercel.app,http://localhost:5173
CORS_ALLOWED_ORIGINS=

# Cloudinary credentials for admin image uploads. Uploads return 503 until all three are set.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Set to "true" only if MongoDB Atlas SRV lookups fail on your machine (mostly Windows).
# This overrides the DNS resolver for the whole process, so leave it unset in production.
FORCE_PUBLIC_DNS=

PORT=5000
